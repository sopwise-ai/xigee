# 环境配置模板 - 复制为 .env.dev / .env.sit / .env.prod 并填写真实值。
# 真实的 .env.<env> 已被 .gitignore 忽略, 本文件是仓库里唯一可提交的 env 文件:
# 密钥只写进 .env.<env>, 不要写在这里。
#
# 注意: pydantic-settings 默认 extra="forbid" —— .env.<env> 里出现未知键会让服务
#       直接启动失败(Extra inputs are not permitted)。只写下面列出的键。
#       已废弃的 EXPORT_OUTPUT_PATH 就是这样一个键, 改名后只能写 EXPORT_OUTPUT_DIR。
#
# APP_ENV 刻意不在这里设置: 决定加载哪个 .env.<env> 的是【进程环境变量】
# (app/core/config.py 用 os.getenv("APP_ENV") 选文件名, 早于本文件被读取), 写在这一行
# 只会覆盖 Settings.app_env 字段, 而且很容易让人以为"改这里就能切环境"。切环境用:
#   APP_ENV=sit make dev           或   APP_ENV=prod uv run python -m app
#   APP_ENV=sit make test ALLOW_SHARED_DB=1
# 真要写也可以(进程环境变量优先), 但它不会改变实际加载的是哪个文件。
# APP_ENV=dev
# prod 下必须为 false, 否则启动直接失败
APP_DEBUG=true
# make dev / make sit 用这两个值决定监听地址; make prod 默认监听 0.0.0.0
APP_HOST=127.0.0.1
APP_PORT=8000
# 日志级别(可选): DEBUG / INFO / WARNING / ERROR / CRITICAL, 大小写不敏感
LOG_LEVEL=INFO

# MySQL(必填)。dev 库是 5.7, prod 库是 8.0; 建表用 make db-init 跑 sql/schema.sql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# CORS(逗号分隔, 必填; 不接受 * 也不接受空值, 启动时会校验并拒绝)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# API Key(必填; 取值即写操作的 X-API-Key 请求头)
# dev 之外的取值不能等于默认的 dev-secret-key; 生成: openssl rand -hex 32
API_KEY=

# ── AI 评分管线(可选; 只有 `python -m app.scoring` 用到, 服务进程不调用模型) ──
# 调用方式是 DeepSeek 的 Responses API; 模型必须用 `deepseek-flash`:
# 旧的 deepseek-chat / deepseek-reasoner 已于 2026-07-24 下线, 写旧名会直接失败。
# 留空不影响服务启动与测试; 真正跑评分时缺 LLM_API_KEY 会以退出码 2 报错。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 单次请求超时(秒)。带单位后缀, 免得别处再猜是秒还是毫秒
LLM_TIMEOUT_SECONDS=60
# 网络/限流失败的重试次数(不含 json_schema 降级那一次)
LLM_MAX_RETRIES=2
# 单次响应上限(含思考 token)
LLM_MAX_OUTPUT_TOKENS=4000
# 思考强度: low | high | max。批处理用 low 就够, 也更省钱。
# 注意: 思考模式下没有 temperature, 所以这里没有该配置。
LLM_REASONING_EFFORT=low
# 结构化输出: json_schema(首选, 解码层约束) | json_object(只保证是合法 JSON)
LLM_STRUCTURED_OUTPUT=json_schema
# 每个工具采样几次(>=1; 1 会退化成单次裸分, 不推荐)
SCORING_SAMPLES=3
# 并发请求数
SCORING_CONCURRENCY=4
# 权威度在最终分里的占比 γ: final = (1-γ)·quality + γ·(authority/9)
SCORING_AUTHORITY_WEIGHT=0.50
# --stale-days 不带数值时的默认天数
SCORING_STALE_DAYS=90
